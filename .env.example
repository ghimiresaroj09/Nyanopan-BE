# --- Django ---
# development (default) | production  — Render uses production.
# DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=True

# --- Database (Neon Postgres) ---
# Empty DATABASE_URL = local db.sqlite3 (development only).
#
# Neon exposes two endpoints for the same database; use both:
#   pooled   (host contains "-pooler") -> application traffic
#   direct   (no "-pooler")           -> migrations / psql / pg_dump
# PgBouncer runs in transaction mode and does not support session-level state,
# which is why schema migrations go through the direct endpoint.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.<region>.aws.neon.tech/dbname?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.<region>.aws.neon.tech/dbname?sslmode=require

# --- Cloudinary (image storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=ecommerce
# Force the storage backend on/off regardless of the credentials above.
# Default: on when all three credentials are set, otherwise files are stored
# under local media/ (MEDIA_ROOT) — handy for development without an account.
# USE_CLOUDINARY=True
# Per-image upload limit, in megabytes.
MAX_IMAGE_UPLOAD_MB=5

# --- Hosts / CORS ---
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production only: scheme + host of any custom domain (CSRF for the admin login).
# The *.onrender.com hostname is trusted automatically.
# CSRF_TRUSTED_ORIGINS=https://api.example.com

# --- Production serving (see README "Deploying to Render") ---
# SECURE_SSL_REDIRECT=True   # redirect http -> https (behind Render's proxy)
# SECURE_HSTS_SECONDS=31536000
# LOG_LEVEL=INFO
# PORT=10000                 # gunicorn bind port (Render sets this)
# WEB_CONCURRENCY=2          # gunicorn worker processes
# GUNICORN_THREADS=4         # threads per worker
# GUNICORN_TIMEOUT=120

# --- Seeded admin (auto-created after `migrate` when set) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Internal cron endpoints (called by cron-job.org) ---
# Shared secret sent in the X-Cron-Secret header. Must be at least 16
# characters; leave empty to disable the endpoints (they answer 503).
# Generate one with: openssl rand -hex 32
CRON_SECRET=
