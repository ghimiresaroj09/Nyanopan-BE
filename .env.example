# --- Django ---
# development (default) | production.
# DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=True

# --- Database (MySQL/MariaDB) ---
# Empty DATABASE_URL = local db.sqlite3 (development only). Production requires MySQL.
# In cPanel, use the MySQL host/name/user/password shown in MySQL Databases.
# URL-encode special characters in the username or password.
# DATABASE_URL=mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME

# --- Cloudinary (image storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=ecommerce
# Force the storage backend on/off regardless of the credentials above.
# Default: on when all three credentials are set, otherwise files are stored
# under local media/ (MEDIA_ROOT) — handy for development without an account.
# USE_CLOUDINARY=True
# Per-image upload limit, in megabytes.
MAX_IMAGE_UPLOAD_MB=5

# --- Hosts / CORS ---
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production only: scheme + host of any custom domain (CSRF for the admin login).
# The *.onrender.com hostname is trusted automatically.
# CSRF_TRUSTED_ORIGINS=https://api.example.com

# --- Production serving ---
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# LOG_LEVEL=INFO
# PORT=10000                 # gunicorn bind port (Render sets this)
# WEB_CONCURRENCY=2          # gunicorn worker processes
# GUNICORN_THREADS=4         # threads per worker
# GUNICORN_TIMEOUT=120

# --- Seeded admin (auto-created after `migrate` when set) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- SMTP email notifications ---
# Set EMAIL_HOST to enable SMTP. The site configuration email receives new
# order alerts only; customers receive order confirmation and status emails.
# The site email is also used as the preferred sender address.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=

# --- Internal cron endpoints (called by cron-job.org) ---
# Shared secret sent in the X-Cron-Secret header. Must be at least 16
# characters; leave empty to disable the endpoints (they answer 503).
# Generate one with: openssl rand -hex 32
CRON_SECRET=
